// A Crusty program that links the real `bitflags` crate and invokes its
// `bitflags!` macro directly — the natural way to use the crate.
//
// This works because an item-position bang-macro with a brace body
// (`name! { ... }`) parses and emits verbatim (ADR-0002), and `#import`
// brings the macro into scope. The generated `Flags` type is then used through
// ordinary Crusty surface: `@Flags.A` lowers to `Flags::A` (a type-scoped path,
// typed `Auto` and left to rustc), bitwise `|` combines them, and the
// generated `.contains()` / `.bits()` methods are plain method calls.
#import bitflags.bitflags

bitflags! {
    pub struct Flags: u32 {
        const A = 1;
        const B = 2;
        const C = 4;
    }
}

void main() {
    // Combine flags with the generated bitwise OR.
    let combined = @Flags.A | @Flags.B;

    // Test membership with the generated `contains`.
    let has_a = combined.contains(@Flags.A);
    let has_b = combined.contains(@Flags.B);
    let has_c = combined.contains(@Flags.C);

    println!(
        "combined={} has_a={} has_b={} has_c={}",
        combined.bits(), has_a, has_b, has_c
    );
}
